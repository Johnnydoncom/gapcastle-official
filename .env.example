# ---------------------------------------------------------------------------
# Gap Castle — environment
# Copy to .env.local for local work. On Vercel, add the same keys under
# Project → Settings → Environment Variables. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database (MySQL 8 / MariaDB 10.4+) -------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gapcastle_web
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# Connections per server instance (defaults: 10 locally, 3 on Vercel)
# DB_POOL_SIZE=3

# --- Admin -------------------------------------------------------------------
# Signs the staff session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-characters

# Optional: encrypts secrets saved in the dashboard (the SMTP password). Defaults to
# SESSION_SECRET. Changing either means the SMTP password must be entered again.
# SETTINGS_ENCRYPTION_KEY=

# Default admin created by `npm run db:seed` — only when no user exists yet.
# Leave ADMIN_PASSWORD empty to have one generated and printed once (10–72 characters).
# Locked out? `npm run user:password -- you@example.com` sets a new password.
ADMIN_EMAIL=admin@gapcastle.com
ADMIN_NAME=Gap Castle Admin
ADMIN_PASSWORD=

# --- Email (SMTP) --------------------------------------------------------------
# Normally configured by an admin in Admin → Settings → Email server. These values
# are only a fallback, used while no SMTP host is saved in the dashboard.
# With neither, submissions are still saved and emails are logged as "skipped".
SMTP_HOST=
SMTP_PORT=465
# SMTP_SECURE=true        # defaults to true on port 465, otherwise STARTTLS
SMTP_USER=
SMTP_PASS=
# MAIL_FROM_ADDRESS=      # defaults to SMTP_USER

# --- Site ----------------------------------------------------------------------
# Public URL used for links inside emails, including password reset links.
# Reset links always use this value (never the request's Host header), so set it
# to http://localhost:3000 for local development.
APP_URL=https://gapcastle.com
